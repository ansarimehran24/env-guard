{
  "name": "envguardian",
  "version": "1.0.0",
  "description": "Production-ready developer security toolkit and validator for environment variables",
  "author": "Aditya Arora",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaarora/envguardian.git"
  },
  "homepage": "https://github.com/adityaarora/envguardian#readme",
  "bugs": {
    "url": "https://github.com/adityaarora/envguardian/issues"
  },
  "keywords": [
    "env",
    "environment",
    "dotenv",
    "security",
    "secret-detection",
    "validation",
    "schema",
    "zod",
    "cli",
    "git-safety",
    "linter",
    "guardian"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "envguardian": "./bin/envguardian.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.1.1"
  }
}
